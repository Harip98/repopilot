# Copy to .env. Every field is optional; the values below are the defaults in
# services/agent-svc/src/repopilot/config.py, for running the agent on the host.
# docker-compose.yml passes these same variables to the `app` profile's api and worker, with
# the same defaults, except that it points them at the compose Postgres, Redis and sandbox-svc.
REPOPILOT_PG_HOST=127.0.0.1
REPOPILOT_PG_PORT=5434
REPOPILOT_PG_DB=repopilot
REPOPILOT_PG_USER=repopilot
REPOPILOT_PG_PASSWORD=repopilot_dev_pw
REPOPILOT_REDIS_URL=redis://127.0.0.1:6380/0
REPOPILOT_SANDBOX_URL=http://127.0.0.1:8090
# Shared with sandbox-svc (min 16 chars). Change it outside local dev.
REPOPILOT_SANDBOX_TOKEN=dev-sandbox-token-change-me
# Any OpenAI-compatible endpoint. Ollama: http://127.0.0.1:11434/v1 from the host, or
# http://host.docker.internal:11434/v1 from the compose api/worker containers (on a Linux
# host, Ollama must then listen beyond loopback: OLLAMA_HOST=0.0.0.0).
# The README results used REPOPILOT_LLM_MODEL=qwen2.5-7b-16k (see deploy/ollama/).
REPOPILOT_LLM_BASE_URL=https://api.openai.com/v1
REPOPILOT_LLM_API_KEY=
REPOPILOT_LLM_MODEL=gpt-4.1-mini
# Seconds per model call; slow local models need more
REPOPILOT_LLM_TIMEOUT_S=120
# USD per 1M tokens, for cost tracking; leave 0 for local models
REPOPILOT_LLM_PRICE_IN=0
REPOPILOT_LLM_PRICE_OUT=0
# Fine-grained PAT: issues read, contents + pull requests write. Never enters the sandbox.
REPOPILOT_GITHUB_TOKEN=
REPOPILOT_GITHUB_API_URL=https://api.github.com
# API (repopilot serve) and UI. The console has its own settings: see web/.env.example.
REPOPILOT_API_TOKEN=dev-api-token-change-me
REPOPILOT_UI_ORIGIN=http://127.0.0.1:3000
# Seconds before an unacknowledged job is reclaimed by another worker
REPOPILOT_JOB_VISIBILITY_S=1800
# Tracing (OpenTelemetry/OTLP over HTTP). Local: http://127.0.0.1:4318 with the compose `otel`
# profile. Langfuse: https://cloud.langfuse.com/api/public/otel plus the two keys below.
REPOPILOT_OTEL_ENDPOINT=
REPOPILOT_OTEL_CAPTURE_CONTENT=false
REPOPILOT_LANGFUSE_PUBLIC_KEY=
REPOPILOT_LANGFUSE_SECRET_KEY=
# Optional hybrid code index (repopilot solve/eval run --code-index); 768-dim embeddings.
# The embedding endpoint defaults to REPOPILOT_LLM_BASE_URL.
REPOPILOT_EMBED_MODEL=nomic-embed-text
REPOPILOT_EMBED_BASE_URL=
# Enables the hybrid find_code index for service runs (repopilot worker).
REPOPILOT_CODE_INDEX=false
# Directories `repopilot mcp` may open, separated by ':' (';' on Windows). Empty: the
# directory the server starts in.
REPOPILOT_MCP_ROOTS=
# Not read from this file: REPOPILOT_ROOT (environment only) overrides where the repo root,
# and so this .env, is found. The agent-svc image sets it to /app.
