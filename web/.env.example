# Copy to web/.env.local (or set these in the environment). The values below are the defaults
# in app/api/rp/[...path]/route.ts and app/runs/[id]/page.tsx.
#
# Server-side only: the browser talks to /api/rp/*, and this app adds the token. The token must
# match REPOPILOT_API_TOKEN in the root .env.
REPOPILOT_API_URL=http://127.0.0.1:8000
REPOPILOT_API_TOKEN=dev-api-token-change-me
# Comma-separated hosts the console is served under (as in the Host header); the proxy refuses
# any other, which stops DNS-rebinding pages from using its token.
REPOPILOT_UI_HOSTS=127.0.0.1:3000,localhost:3000
# Optional "Open trace" link on each run: a URL with {trace_id} in place of the run's trace id,
# e.g. http://127.0.0.1:16686/trace/{trace_id} for the compose Jaeger. Inlined at build time,
# so set it before `npm run build` (or `npm run dev`). Empty: no link.
NEXT_PUBLIC_TRACE_URL=
